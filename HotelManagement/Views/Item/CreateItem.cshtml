@model HotelManagement.ViewModels.CreateItemViewModel

<h2>Create Item</h2>

<div class="row">
    <div class="col">
        <form id="createItemForm" class="p-3">
            <input type="hidden" asp-for="ItemId" />

            <div class="row mb-3">
                <div class="col-md-3">
                    <label asp-for="ItemName"></label>
                    <input asp-for="ItemName" type="text" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" type="number" class="form-control" />
                </div>
            </div>
            <div class="form-group col-md-3 d-flex align-items-center">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label class="form-check-label">Is Active</label>
                </div>
            </div>

            <div class="text-start" style="margin-top: 50px;">
                <button type="submit" class="btn btn-success" id="submitBtnCreateItem">Save</button>
                <a asp-action="ItemList" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
